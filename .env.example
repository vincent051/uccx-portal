# Portail
SECRET_KEY=
PORTAL_HOST=portal.example.com
PUBLIC_BASE_URL=https://portal.example.com
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin

# Database (sqlite local / postgres en docker-compose)
DATABASE_URL=sqlite:////data/portal.db

# Admin API UCCX (apps, calendriers, prompts)
UCCX_HOST=192.0.2.10
UCCX_USER=
UCCX_PASSWORD=
UCCX_VERIFY_SSL=false
UCCX_SYNC_ENABLED=true
UCCX_DOCUMENT_FOLDER=en

# Traefik / Let's Encrypt
ACME_EMAIL=admin@example.com
# Basic auth site + dashboard — plaintext, appliqué à chaque `docker compose up`
# (service auth-init → letsencrypt/htpasswd). Défaut = ADMIN_* si omis.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-basic-auth

# HTTP direct pour UCCX (Create URL Document / TTS — sans HTTPS)
UCCX_HTTP_PORT=8080
UCCX_HTTP_BIND=0.0.0.0
# Exemple URL script UCCX : http://<IP-LAN>:8080/api/public/tts
# TTS_ALLOWED_CIDRS=192.0.2.0/24,127.0.0.1/32,::1/128
# TTS_PUBLIC_ENGINE=piper
# EDGE_ENABLED=false
# ELEVENLABS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Whisper STT (transcription prompts)
STT_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/data/whisper

# SAML SSO (opérateurs) — voir docs/SAML_SSO.md ; secrets aussi via UI Admin Settings
SAML_ENABLED=false
# SAML_IDP_METADATA_URL=https://idp.example.com/metadata
# SAML_USERID_ATTR=uid
# SETTINGS_FERNET_KEY=  # défaut = dérivé de SECRET_KEY

# Skills scheduler (0 = off)
SKILL_SCHEDULER_INTERVAL_SEC=60

# Optional Post UI assets (css/fonts/img/js) — see docker-compose.post-assets.yml.example
# UCCX_PUBLIC_DIR=/path/to/uccx/public
